#!/bin/sh
set -eu
ORIG=${SSH_ORIGINAL_COMMAND:-}

# backup_age: idade em horas do dump mais recente; -1 se nao houver nenhum.
# Somente leitura, sem alvo -- tratado antes do parse de TYPE/ACTION/ID.
if [ "$ORIG" = "backup_age" ]; then
  recente=$(ls -t /mnt/drive/dump/*.vma.zst /mnt/drive/dump/*.tar.zst 2>/dev/null | head -1)
  if [ -z "$recente" ]; then
    echo -1
  else
    echo $(( ( $(date +%s) - $(stat -c %Y "$recente") ) / 3600 ))
  fi
  exit 0
fi

# updates: relatorio de atualizacoes pendentes no parque, gerado pelo timer
# semanal verifica-atualizacoes.timer. Somente leitura, sem alvo -- tratado
# antes do parse de TYPE/ACTION/ID, igual ao backup_age acima.
if [ "$ORIG" = "updates" ]; then
  if [ -f /var/lib/portal/atualizacoes.txt ]; then
    cat /var/lib/portal/atualizacoes.txt
  else
    echo "nunca verificado"
  fi
  exit 0
fi

set -- $ORIG
[ $# -ge 2 ] || { echo invalid; exit 2; }
TYPE=$1
ACTION=$2
ID=${3:-}
case "$TYPE:$ID" in
  vm:110|vm:120|vm:301|ct:100|ct:102|ct:104|ct:201) ;;
  gamebox:) ;;
  host:) ;;
  *) echo denied; exit 3 ;;
esac

# Desligamento do proprio Proxmox. So aceita a acao "shutdown"; qualquer outra e
# recusada. Derruba tudo junto, inclusive o Home Assistant.
if [ "$TYPE" = "host" ]; then
  case "$ACTION" in
    shutdown)
      nohup sh -c "sleep 2; /sbin/shutdown -h now" >/dev/null 2>&1 &
      echo scheduled
      ;;
    *) echo invalid; exit 2 ;;
  esac
  exit 0
fi
# O Batocera (VM 120) pega DHCP e NAO esta na tailnet, entao nao ha nome para
# usar. Ate 19/09/2026 este bloco tinha 192.168.15.13 cravado; a casa mudou de
# endereco, o roteador e outro, e o .13 passou a ser o starloco (CT 104). O
# botao "sair do console" do Home Assistant apontava para a maquina errada.
#
# Nao adianta cravar o IP novo: e DHCP, muda de novo. O MAC nao muda, entao
# resolvemos por ele na hora da chamada. Se nao achar, falha dizendo o porque
# em vez de abrir SSH para quem quer que esteja no IP de ontem.
GAMEBOX_MAC=bc:24:11:c1:8e:bc

gamebox_ip() {
  ip=$(ip neigh | grep -i "$GAMEBOX_MAC" | awk '{print $1}' | grep -E '^[0-9]+\.' | head -1)
  if [ -z "$ip" ]; then
    # A VM pode estar viva mas fora do cache ARP; um ping de broadcast enche
    # a tabela sem precisar de arp-scan instalado.
    ping -b -c 2 -W 1 "$(ip -4 route show dev vmbr0 | grep -oE '[0-9.]+/[0-9]+' | head -1 | cut -d/ -f1 | sed 's/\.[0-9]*$/.255/')" >/dev/null 2>&1 || true
    ip=$(ip neigh | grep -i "$GAMEBOX_MAC" | awk '{print $1}' | grep -E '^[0-9]+\.' | head -1)
  fi
  [ -n "$ip" ] || return 1
  echo "$ip"
}

if [ "$TYPE" = "gamebox" ]; then
  case "$ACTION" in
    exit_console)
      GB=$(gamebox_ip) || { echo "gamebox nao encontrado na rede (MAC $GAMEBOX_MAC); esta ligada?"; exit 4; }
      ssh -i /root/.ssh/ha_batocera_control_rsa -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/root/.ssh/known_hosts "root@$GB" 'nohup sh -c "sleep 1; batocera-es-swissknife --emukill 5 || true; pkill -f pcsx2-qt || true; pkill -f emulatorlauncher || true; batocera-es-swissknife --restart || true" >/tmp/ha-exit-console.log 2>&1 &'
      echo scheduled
      ;;
    *) echo invalid; exit 2 ;;
  esac
  exit 0
fi
case "$TYPE" in
  vm) TOOL=qm ;;
  ct) TOOL=pct ;;
  *) echo invalid; exit 2 ;;
esac
status() {
  $TOOL status "$ID" | awk '{print $2}'
}
case "$ACTION" in
  status)
    status
    ;;
  start)
    if [ "$(status)" = "running" ]; then echo running; exit 0; fi
    $TOOL start "$ID"
    sleep 1
    status
    ;;
  shutdown)
    if [ "$(status)" != "running" ]; then echo stopped; exit 0; fi
    if [ "$TYPE" = "vm" ]; then
      qm shutdown "$ID" --timeout 60 || true
    else
      pct shutdown "$ID" --timeout 60 || true
    fi
    sleep 1
    status
    ;;
  reboot)
    [ "$TYPE:$ID" = "vm:120" ] || { echo denied; exit 3; }
    if [ "$(status)" != "running" ]; then
      qm start "$ID"
    else
      qm reboot "$ID" || { qm stop "$ID"; sleep 3; qm start "$ID"; }
    fi
    sleep 1
    status
    ;;
  *) echo invalid; exit 2 ;;
esac
